# Copy to .env.local (apps/web/.env.local) for local development. Every variable is optional.

# Public URL of the site. Used for canonical links, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Link shown in the header, footer and contribute page.
NEXT_PUBLIC_REPO_URL=https://github.com/RaydanAridiCS/toolwright

# Postgres connection string for the tool-request board.
# Leave empty to use an in-memory store seeded with example ideas (data resets on restart).
DATABASE_URL=
