# Copy to .env.local (apps/web/.env.local) for local development. Every variable is optional.

# Public URL of the site. Used for canonical links, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Link shown in the header, footer and contribute page.
NEXT_PUBLIC_REPO_URL=https://github.com/RaydanAridiCS/toolwright

# Postgres connection string for the tool-request board (a runtime variable, set on the server).
# Leave empty to use an in-memory store seeded with example ideas (data resets on restart).
# Hosted Postgres usually needs SSL: add ?sslmode=require to the end of the string.
# After setting it on a server: run the migrations once (docs/maintainers.md), then `npm run check:deploy`.
DATABASE_URL=

# Build-time switch: set to "block" to ask AI training crawlers (GPTBot, ClaudeBot, ...) not to crawl.
# Search and answer crawlers stay allowed either way. Leave empty to allow everyone. See docs/seo.md.
TOOLWRIGHT_AI_TRAINING=
